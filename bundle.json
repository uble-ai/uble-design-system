{"pages": [{"id": 12613, "slug": "lp-wake", "html": "<!doctype html>\n<html lang=\"pt-BR\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n{HEAD}\n</head><body>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600&display=swap');\n  :root{\n    --canvas:#FBFAF8;\n    --surface:#FFFFFF;\n    --ink:#14131A;\n    --ink-soft:#3A3742;\n    --muted:#6B6770;\n    --hair:#E9E5DE;\n    --orange:#DC602E;\n    --orange-deep:#B84E25;\n    --orange-tint:#FBEEE7;\n    --purple:#C111E0;\n    --purple-tint:#F6E6FB;\n    --red:#D8443C;\n    --font-display:'Space Grotesk',system-ui,sans-serif;\n    --font-body:'Inter',system-ui,sans-serif;\n    --font-mono:'Space Mono',ui-monospace,monospace;\n    --r:14px;\n    --maxw:1120px;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--canvas);color:var(--ink);\n    font-family:var(--font-body);font-size:17px;line-height:1.6;\n    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;\n  }\n  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}\n  a{color:inherit;text-decoration:none}\n  h1,h2,h3{font-family:var(--font-display);font-weight:600;letter-spacing:-.02em;line-height:1.05}\n  .eyebrow{\n    font-family:var(--font-mono);font-size:12px;font-weight:700;\n    letter-spacing:.18em;text-transform:uppercase;color:var(--muted);\n  }\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    position:sticky;top:0;z-index:50;background:rgba(251,250,248,.86);\n    backdrop-filter:saturate(140%) blur(10px);border-bottom:1px solid var(--hair);\n  }\n  .topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}\n  .lockup{display:flex;align-items:center;gap:16px}\n  .lockup img{display:block}\n  .lockup .uble{height:26px}\n  .lockup .wake{height:21px}\n  .lockup .x{color:var(--muted);font-family:var(--font-display);font-size:18px;font-weight:400}\n  .partner-tag{\n    font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.12em;\n    text-transform:uppercase;color:var(--ink);background:var(--surface);\n    border:1px solid var(--hair);border-radius:100px;padding:7px 14px;\n  }\n  .btn-top{\n    display:inline-flex;align-items:center;gap:8px;background:var(--orange)!important;color:#fff!important;text-decoration:none;\n    font-weight:600;font-size:14px;padding:11px 20px;border-radius:100px;\n    transition:background .18s ease,transform .18s ease;\n  }\n  .btn-top:hover{background:var(--orange-deep)}\n  .topbar-cta{display:flex;align-items:center;gap:18px}\n\n  /* ---------- hero ---------- */\n  .hero{padding:78px 0 64px;position:relative;overflow:hidden}\n  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}\n  .hero h1{font-size:clamp(34px,5vw,58px);font-weight:700;margin:18px 0 0}\n  .hero h1 .umark{color:var(--orange);background:transparent;padding:0}\n  .hero .lead{font-size:19px;color:var(--ink-soft);margin-top:22px;max-width:30em}\n  .hero .actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px}\n  .btn{\n    display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:16px;\n    padding:15px 26px;border-radius:100px;transition:background .18s ease,transform .18s ease,border-color .18s;\n    cursor:pointer;border:1px solid transparent;\n  }\n  .btn-primary{background:var(--orange);color:#fff}\n  .btn-primary:hover{background:var(--orange-deep);transform:translateY(-1px)}\n  .btn-ghost{background:transparent;color:var(--ink);border-color:var(--hair)}\n  .btn-ghost:hover{border-color:var(--ink);}\n  .hero .micro{display:flex;gap:22px;margin-top:26px;flex-wrap:wrap}\n  .hero .micro > span{font-size:14px;color:var(--muted);display:inline-flex;align-items:center;gap:7px}\n  .hero .micro b{color:var(--ink);font-weight:600}\n  .dot{width:6px;height:6px;border-radius:50%;background:var(--orange);display:inline-block}\n\n  /* ---------- signature: transaction ticket ---------- */\n  .ticket-stage{position:relative}\n  .ticket{\n    background:var(--ink);color:#F4F2EE;border-radius:20px;padding:26px 26px 22px;\n    box-shadow:0 30px 60px -28px rgba(20,19,26,.55);position:relative;overflow:hidden;\n  }\n  .ticket .seam{position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--orange),var(--purple))}\n  .ticket-head{display:flex;align-items:center;justify-content:space-between;margin-top:6px}\n  .ticket-head .tt{font-family:var(--font-mono);font-size:11px;letter-spacing:.16em;color:#9A96A2;text-transform:uppercase}\n  .ticket-head .brand{font-family:var(--font-mono);font-size:11px;color:#9A96A2}\n  .ticket .card-no{font-family:var(--font-mono);font-size:15px;color:#CFCBD4;margin-top:20px;letter-spacing:.06em}\n  .ticket .amount{font-family:var(--font-display);font-weight:700;font-size:40px;letter-spacing:-.02em;margin-top:6px}\n  .status-row{display:flex;align-items:center;gap:12px;margin-top:18px;min-height:34px}\n  .status{\n    font-family:var(--font-mono);font-weight:700;font-size:13px;letter-spacing:.1em;text-transform:uppercase;\n    padding:7px 13px;border-radius:8px;display:inline-flex;align-items:center;gap:8px;\n  }\n  .status.declined{background:rgba(216,68,60,.16);color:#FF8A82;border:1px solid rgba(216,68,60,.4)}\n  .status.recovered{background:rgba(220,96,46,.16);color:#FFB48C;border:1px solid rgba(220,96,46,.5)}\n  .arrow{color:#6F6B77;font-family:var(--font-mono);font-size:15px}\n  .channels{display:flex;gap:9px;margin-top:22px;border-top:1px solid rgba(255,255,255,.08);padding-top:18px}\n  .chan{\n    flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;\n    font-family:var(--font-mono);font-size:10.5px;letter-spacing:.08em;color:#86828E;text-transform:uppercase;\n  }\n  .chan .ic{\n    width:38px;height:38px;border-radius:11px;display:grid;place-items:center;\n    background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);transition:all .3s ease;\n  }\n  .chan .ic svg{width:18px;height:18px;stroke:#9A96A2;fill:none;stroke-width:1.7}\n  .ticket .footnote{font-family:var(--font-mono);font-size:10.5px;color:#6F6B77;margin-top:18px;text-align:center;letter-spacing:.04em}\n\n  /* animation */\n  @keyframes flipOut{0%,100%{opacity:0;transform:translateY(6px)}12%,46%{opacity:1;transform:none}58%{opacity:0;transform:translateY(-6px)}}\n  @keyframes flipIn{0%,52%{opacity:0;transform:translateY(8px)}64%,94%{opacity:1;transform:none}}\n  .anim .status.declined{animation:flipOut 6s ease-in-out infinite}\n  .anim .status.recovered{animation:flipIn 6s ease-in-out infinite}\n  .anim .chan:nth-child(1) .ic{animation:lite 6s ease-in-out infinite;animation-delay:3.3s}\n  .anim .chan:nth-child(2) .ic{animation:lite 6s ease-in-out infinite;animation-delay:3.7s}\n  .anim .chan:nth-child(3) .ic{animation:lite 6s ease-in-out infinite;animation-delay:4.1s}\n  @keyframes lite{\n    0%,50%{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.08)}\n    58%,82%{background:rgba(220,96,46,.18);border-color:rgba(220,96,46,.55)}\n    92%,100%{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.08)}\n  }\n\n  /* ---------- section scaffold ---------- */\n  section{padding:74px 0}\n  .sec-head{max-width:34em}\n  .sec-head h2{font-size:clamp(27px,3.6vw,40px);margin-top:14px}\n  .sec-head p{color:var(--muted);margin-top:14px;font-size:18px}\n\n  /* ---------- não / é ---------- */\n  .truth{background:var(--surface);border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}\n  .truth-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:42px}\n  .col-not,.col-is{border-radius:18px;padding:30px 30px 26px}\n  .col-not{background:var(--canvas);border:1px solid var(--hair)}\n  .col-is{background:var(--ink);color:#F4F2EE;position:relative;overflow:hidden}\n  .col-is .seam{position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--orange),var(--purple))}\n  .col-label{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}\n  .col-not .col-label{color:var(--muted)}\n  .col-is .col-label{color:#FFB48C}\n  .tlist{list-style:none;margin-top:20px;display:flex;flex-direction:column;gap:15px}\n  .tlist li{display:flex;gap:13px;align-items:flex-start;font-size:16.5px;line-height:1.45}\n  .tlist .ico{flex:0 0 auto;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;margin-top:1px}\n  .col-not .ico{background:#EDE9E3;color:var(--muted)}\n  .col-is .ico{background:rgba(220,96,46,.22);color:#FFB48C}\n  .col-not li b,.col-is li b{font-weight:600}\n  .col-is li{color:#E6E3DE}\n  .tlist svg{width:12px;height:12px;stroke-width:2.4;fill:none}\n\n  /* ---------- como funciona ---------- */\n  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:46px}\n  .step{background:var(--surface);border:1px solid var(--hair);border-radius:18px;padding:28px 26px;position:relative}\n  .step .num{font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--orange);letter-spacing:.1em}\n  .step h3{font-size:21px;margin-top:14px;font-weight:600}\n  .step p{color:var(--muted);margin-top:10px;font-size:15.5px;line-height:1.5}\n  .step .si{width:44px;height:44px;border-radius:12px;background:var(--orange-tint);display:grid;place-items:center;margin-bottom:18px}\n  .step .si svg{width:22px;height:22px;stroke:var(--orange);fill:none;stroke-width:1.7}\n\n  /* ---------- offer band ---------- */\n  .offer{background:var(--ink);color:#F4F2EE;position:relative;overflow:hidden}\n  .offer .seam{position:absolute;inset:0 0 auto 0;height:5px;background:linear-gradient(90deg,var(--orange),var(--purple))}\n  .offer .wrap{display:grid;grid-template-columns:1.3fr .7fr;gap:40px;align-items:center}\n  .offer .eyebrow{color:#FFB48C}\n  .offer h2{font-size:clamp(26px,3.4vw,38px);margin-top:14px;color:#fff}\n  .offer h2 .hl{color:var(--orange)}\n  .offer p{color:#B9B5BE;margin-top:14px;font-size:16.5px;max-width:34em}\n  .offer-cta{display:flex;flex-direction:column;gap:14px}\n  .offer-pill{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 18px}\n  .offer-pill .big{font-family:var(--font-display);font-weight:700;font-size:30px;line-height:1;color:#fff}\n  .offer-pill .lbl{font-size:13.5px;color:#B9B5BE;line-height:1.3}\n  .offer-pill.purple .big{color:#E69BF5}\n\n  /* ---------- form ---------- */\n  .lead-sec{padding:84px 0}\n  .lead-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:56px;align-items:start}\n  .lead-sec h2{font-size:clamp(27px,3.6vw,40px);margin-top:14px}\n  .lead-sec .pitch{color:var(--muted);margin-top:16px;font-size:17.5px}\n  .assured{margin-top:26px;display:flex;flex-direction:column;gap:14px}\n  .assured div{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;color:var(--ink-soft)}\n  .assured .ck{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--orange-tint);display:grid;place-items:center;margin-top:1px}\n  .assured .ck svg{width:12px;height:12px;stroke:var(--orange);stroke-width:2.6;fill:none}\n\n  .card{background:var(--surface);border:1px solid var(--hair);border-radius:22px;padding:34px;box-shadow:0 24px 50px -36px rgba(20,19,26,.4)}\n  .card .seam{height:4px;border-radius:4px;background:linear-gradient(90deg,var(--orange),var(--purple));margin:-8px 0 24px}\n  .field{margin-bottom:16px}\n  .field label{display:block;font-size:13.5px;font-weight:600;color:var(--ink-soft);margin-bottom:7px}\n  .field input{\n    width:100%;padding:13px 15px;border:1px solid var(--hair);border-radius:11px;font-size:16px;\n    font-family:var(--font-body);background:var(--canvas);transition:border-color .15s,box-shadow .15s;color:var(--ink);\n  }\n  .field input:focus{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px rgba(220,96,46,.14);background:#fff}\n  .row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n  .consent{display:flex;gap:11px;align-items:flex-start;margin:6px 0 22px;font-size:13px;color:var(--muted);line-height:1.45}\n  .consent input{margin-top:3px;width:16px;height:16px;accent-color:var(--orange);flex:0 0 auto}\n  .submit{width:100%;justify-content:center;font-size:17px;padding:16px}\n  .err{color:var(--red);font-size:12.5px;margin-top:5px;display:none}\n  .field.invalid input{border-color:var(--red)}\n  .field.invalid .err{display:block}\n  .form-foot{text-align:center;font-family:var(--font-mono);font-size:11px;color:var(--muted);margin-top:16px;letter-spacing:.04em}\n\n  /* thank you */\n  .thanks{display:none;text-align:center;padding:14px 4px}\n  .thanks.show{display:block;animation:fade .4s ease}\n  .thanks .badge{width:64px;height:64px;border-radius:50%;background:var(--orange-tint);display:grid;place-items:center;margin:0 auto 22px}\n  .thanks .badge svg{width:30px;height:30px;stroke:var(--orange);stroke-width:2.4;fill:none}\n  .thanks h3{font-size:26px;font-weight:600}\n  .thanks p{color:var(--muted);margin-top:12px;font-size:16.5px}\n  .wpp{display:inline-flex;align-items:center;gap:10px;background:var(--orange)!important;color:#fff!important;text-decoration:none;font-weight:600;padding:15px 28px;border-radius:100px;margin-top:24px;font-size:16px}\n  .wpp:hover{background:var(--orange-deep)}\n  .wpp svg{width:20px;height:20px;fill:#fff}\n  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}\n\n  /* ---------- footer ---------- */\n  footer{border-top:1px solid var(--hair);padding:34px 0;background:var(--surface)}\n  footer .wrap{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}\n  footer .fl{display:flex;align-items:center;gap:14px}\n  footer img.uble{height:22px}\n  footer img.wake{height:18px}\n  footer .x{color:var(--muted)}\n  footer p{font-size:13px;color:var(--muted)}\n  footer a.priv{font-size:13px;color:var(--muted);text-decoration:underline;text-underline-offset:2px}\n\n  /* ---------- reveal (CSS-only, não depende de JS) ---------- */\n  .reveal{animation:rise .7s ease both}\n  @keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}\n\n  /* ---------- responsive ---------- */\n  @media(max-width:900px){\n    .hero-grid,.truth-grid,.lead-grid,.offer .wrap{grid-template-columns:1fr}\n    .hero{padding:48px 0 40px}\n    .ticket-stage{order:-1}\n    .steps{grid-template-columns:1fr}\n    .offer .wrap{gap:28px}\n    .topbar-cta .btn-top{display:none}\n  }\n  @media(max-width:560px){\n    body{font-size:16px}\n    .wrap{padding:0 18px}\n    .hero h1{font-size:34px}\n    .row2{grid-template-columns:1fr}\n    .lockup .uble{height:22px}.lockup .wake{height:18px}\n    .partner-tag{display:none}\n    .card{padding:24px}\n    .hero .micro{gap:14px}\n  }\n  /* bandeiras de tradução no topo, ao lado do selo */\n  .gt_switcher_wrapper{position:static!important;top:auto!important;right:auto!important;display:flex;align-items:center;gap:6px;z-index:auto!important}\n  .gt_switcher_wrapper img{width:18px;height:18px;opacity:.7;transition:opacity .18s}\n  .gt_switcher_wrapper a:hover img,.gt_switcher_wrapper .gt-current-lang img{opacity:1}\n  @media(prefers-reduced-motion:reduce){\n    *{animation:none!important;scroll-behavior:auto}\n    .reveal{opacity:1;transform:none;transition:none}\n    .anim .status.declined{display:none}\n    .anim .status.recovered{opacity:1;transform:none}\n  }\n</style>\n<!-- TOP BAR -->\n<header class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"lockup\">\n      <img class=\"uble\" src=\"https://uble.ai/wp-content/uploads/2024/06/Screenshot_2024-06-07_at_09.22.45-removebg-preview.png\" alt=\"UBLE\">\n      <span class=\"x\">×</span>\n      <img class=\"wake\" src=\"/wp-content/uploads/uble-site/logos/wake-dark.svg\" alt=\"Wake\">\n    </div>\n    <div class=\"topbar-cta\">\n      <span class=\"partner-tag\">Parceria oficial</span>\n      <a href=\"#ativar\" class=\"btn-top\">Ativar na minha loja</a>\n    </div>\n  </div>\n</header>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div class=\"hero-copy reveal in\">\n      <span class=\"eyebrow\">Exclusivo para lojas Wake Commerce</span>\n      <h1>A venda não acaba quando o <span class=\"umark\">pagamento é recusado.</span></h1>\n      <p class=\"lead\">Pagamento recusado não é falta de interesse: é PIX expirado, boleto vencido, falta de saldo ou dado digitado errado. A UBLE <b>recupera esse faturamento</b> e leva o cliente de volta a um checkout pronto, sem trocar seu gateway.</p>\n      <div class=\"actions\">\n        <a href=\"#ativar\" class=\"btn btn-primary\">Ativar recuperação grátis\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n        <a href=\"#como\" class=\"btn btn-ghost\">Como funciona</a>\n      </div>\n      <div class=\"micro\">\n        <span><span class=\"dot\"></span><span><b>Integração nativa</b>: só chaves de API</span></span>\n        <span><span class=\"dot\"></span><span><b>10 primeiras recuperações</b> por nossa conta</span></span>\n      </div>\n    </div>\n\n    <!-- SIGNATURE TICKET -->\n    <div class=\"ticket-stage reveal in\">\n      <div class=\"ticket anim\" role=\"img\" aria-label=\"Comprovante de pagamento recusado sendo recuperado por WhatsApp, SMS e e-mail\">\n        <span class=\"seam\"></span>\n        <div class=\"ticket-head\">\n          <span class=\"tt\">Autorização · Cartão</span>\n          <span class=\"brand\">UBLE</span>\n        </div>\n        <div class=\"card-no\">•••• •••• •••• 4471</div>\n        <div class=\"amount\">R$ 489,90</div>\n        <div class=\"status-row\">\n          <span class=\"status declined\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg>\n            Recusado\n          </span>\n          <span class=\"arrow\">→</span>\n          <span class=\"status recovered\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n            Recuperado\n          </span>\n        </div>\n        <div class=\"channels\">\n          <div class=\"chan\">\n            <span class=\"ic\"><svg viewBox=\"0 0 24 24\"><path d=\"M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5z\"/></svg></span>\n            WhatsApp\n          </div>\n          <div class=\"chan\">\n            <span class=\"ic\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M3 8l9 6 9-6\"/></svg></span>\n            SMS\n          </div>\n          <div class=\"chan\">\n            <span class=\"ic\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/></svg></span>\n            E-mail\n          </div>\n        </div>\n        <div class=\"footnote\">venda recuperada</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- NÃO / É -->\n<section class=\"truth\" id=\"oque\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">Tire a dúvida de uma vez</span>\n      <h2>Recuperação de pagamento recusado. Nada além disso.</h2>\n      <p>Não é mais uma camada de retentativa nem lembrete para quem desistiu da compra. É uma categoria nova.</p>\n    </div>\n    <div class=\"truth-grid\">\n      <div class=\"col-not reveal\">\n        <span class=\"col-label\">O que não é</span>\n        <ul class=\"tlist\">\n          <li><span class=\"ico\"><svg viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></span><span>Não <b>substitui</b> seus gateways e adquirentes: complementa.</span></li>\n          <li><span class=\"ico\"><svg viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></span><span>Não é <b>retentativa</b> da transação.</span></li>\n          <li><span class=\"ico\"><svg viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></span><span>Não é lembrete para quem <b>desistiu da compra</b>. Aqui o cliente quis pagar.</span></li>\n        </ul>\n      </div>\n      <div class=\"col-is reveal\">\n        <span class=\"seam\"></span>\n        <span class=\"col-label\">O que é</span>\n        <ul class=\"tlist\">\n          <li><span class=\"ico\"><svg viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span>Recuperação da venda que <b>falhou no pagamento</b> ou foi recusada.</span></li>\n          <li><span class=\"ico\"><svg viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span>Atua <b>depois</b> do gateway, onde a receita escapava.</span></li>\n          <li><span class=\"ico\"><svg viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span>Leva o cliente de volta a um checkout pronto por <b>WhatsApp, SMS e e-mail</b>.</span></li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- COMO FUNCIONA -->\n<section id=\"como\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">Como funciona</span>\n      <h2>Do recusado ao recuperado em três passos.</h2>\n      <p>Você ativa uma vez e a recuperação roda sozinha, sem tocar no seu checkout Wake.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step reveal\">\n        <div class=\"si\"><svg viewBox=\"0 0 24 24\"><path d=\"M14 7l-1.5-1.5a4 4 0 0 0-5.7 5.7L9 13M10 17l1.5 1.5a4 4 0 0 0 5.7-5.7L15 11\"/></svg></div>\n        <span class=\"num\">01</span>\n        <h3>Conexão por API</h3>\n        <p>Integração nativa com a Wake. Sem setup, sem dev: você gera as chaves de API (em modo de leitura) e ativa.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"si\"><svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></div>\n        <span class=\"num\">02</span>\n        <h3>Detectamos as falhas</h3>\n        <p>Identificamos em tempo real cada pagamento não realizado, recusado ou que falhou no fechamento.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"si\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 4h16v12H7l-3 3V4z\"/><path d=\"M8 9h8M8 12h5\"/></svg></div>\n        <span class=\"num\">03</span>\n        <h3>Recuperação multicanal</h3>\n        <p>Reabordagem automática por WhatsApp, SMS e e-mail até a venda ser concluída.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- OFFER -->\n<section class=\"offer\">\n  <span class=\"seam\"></span>\n  <div class=\"wrap\">\n    <div class=\"offer-copy reveal\">\n      <span class=\"eyebrow\">Condição exclusiva Wake</span>\n      <h2>Comece a recuperar <span class=\"hl\">sem pagar nada</span> na largada.</h2>\n      <p>As 10 primeiras recuperações são por nossa conta. Depois, o custo acompanha a receita recuperada: previsível e alinhado à performance.</p>\n    </div>\n    <div class=\"offer-cta reveal\">\n      <div class=\"offer-pill\">\n        <span class=\"big\">10</span>\n        <span class=\"lbl\">primeiras recuperações <b style=\"color:#fff;font-weight:600\">grátis</b></span>\n      </div>\n      <div class=\"offer-pill purple\">\n        <span class=\"big\">0</span>\n        <span class=\"lbl\">troca de gateway ou mudança no checkout</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- LEAD FORM -->\n<section class=\"lead-sec\" id=\"ativar\">\n  <div class=\"wrap lead-grid\">\n    <div class=\"lead-copy reveal\">\n      <span class=\"eyebrow\">Ative na sua loja</span>\n      <h2>Ative a recuperação de pagamentos na sua loja Wake.</h2>\n      <p class=\"pitch\">Preencha o formulário que o nosso time entra em contato para ativar a integração e liberar suas 10 recuperações grátis.</p>\n      <div class=\"assured\">\n        <div><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span>Sem trocar de gateway e sem mexer no checkout.</span></div>\n        <div><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span>Integração nativa Wake: só chaves de API.</span></div>\n        <div><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span>Custo atrelado à receita recuperada.</span></div>\n      </div>\n    </div>\n\n    <div class=\"card reveal\">\n      <span class=\"seam\"></span>\n      <form id=\"wakeLead\" novalidate>\n        <input type=\"text\" id=\"empresa_extra\" name=\"empresa_extra\" autocomplete=\"off\" tabindex=\"-1\" aria-hidden=\"true\" style=\"position:absolute;left:-9999px;width:1px;height:1px;opacity:0\">\n        <div class=\"field\" id=\"f-nome\">\n          <label for=\"nome\">Nome</label>\n          <input type=\"text\" id=\"nome\" name=\"nome\" autocomplete=\"name\" placeholder=\"Seu nome\">\n          <span class=\"err\">Informe seu nome.</span>\n        </div>\n        <div class=\"row2\">\n          <div class=\"field\" id=\"f-email\">\n            <label for=\"email\">E-mail</label>\n            <input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"voce@loja.com.br\">\n            <span class=\"err\">E-mail inválido.</span>\n          </div>\n          <div class=\"field\" id=\"f-whats\">\n            <label for=\"whatsapp\">WhatsApp</label>\n            <input type=\"tel\" id=\"whatsapp\" name=\"whatsapp\" inputmode=\"numeric\" autocomplete=\"tel\" placeholder=\"(11) 90000-0000\">\n            <span class=\"err\">Telefone inválido (ex: 11990000000).</span>\n          </div>\n        </div>\n        <div class=\"row2\">\n          <div class=\"field\" id=\"f-loja\">\n            <label for=\"loja\">Nome da loja</label>\n            <input type=\"text\" id=\"loja\" name=\"loja\" placeholder=\"Sua loja\">\n            <span class=\"err\">Informe a loja.</span>\n          </div>\n          <div class=\"field\" id=\"f-site\">\n            <label for=\"site\">URL da loja</label>\n            <input type=\"text\" id=\"site\" name=\"site\" placeholder=\"sualoja.com.br\">\n            <span class=\"err\">URL inválida.</span>\n          </div>\n        </div>\n        <label class=\"consent\">\n          <input type=\"checkbox\" id=\"consent\">\n          <span>Autorizo a UBLE a entrar em contato sobre a ativação da recuperação de pagamentos na minha loja, conforme a <a href=\"/privacy/\" style=\"text-decoration:underline\">política de privacidade</a>.</span>\n        </label>\n        <span class=\"err\" id=\"consent-err\" style=\"margin:-14px 0 16px\">Precisamos da sua autorização para continuar.</span>\n        <button type=\"submit\" class=\"btn btn-primary submit\">Quero ativar a recuperação\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </button>\n        <div class=\"form-foot\">UBLE × Wake · seus dados ficam seguros</div>\n      </form>\n\n      <div class=\"thanks\" id=\"thanks\">\n        <div class=\"badge\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"/></svg></div>\n        <h3>Recebemos seus dados.</h3>\n        <p>Nosso time vai falar com você para ativar a recuperação e liberar as 10 recuperações grátis. Quer adiantar? Chame a gente agora.</p>\n        <a class=\"wpp\" id=\"wppLink\" target=\"_blank\" rel=\"noopener\" href=\"/whatsapp/\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 2.1.55 4.06 1.6 5.83L2 22l4.4-1.15a9.9 9.9 0 0 0 5.64 1.74c5.46 0 9.91-4.45 9.91-9.91